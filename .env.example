# PostgreSQL
POSTGRES_DB=cosmo
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgres://cosmo:change-this-database-password@db:5432/cosmo?sslmode=disable

# API and browser
APP_ADDRESS=:8080
FRONTEND_URL=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=24h

# Admin bootstrap. The password is hashed into PostgreSQL on API startup.
ADMIN_EMAIL=admin@cosmo.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Quản trị viên Cosmo

# Microsoft Entra ID — register a Web application, add the redirect URI below,
# and grant delegated Microsoft Graph User.Read permission to show profile photos.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URL=http://localhost:8080/api/auth/entra/callback

# OpenAI-compatible Model Gateway, for example LiteLLM, Azure facade, vLLM or Ollama.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=company-general
LLM_REQUEST_TIMEOUT=90s

# Knowledge Plane
RAG_SERVICE_URL=http://rag:8000
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cosmo_knowledge
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cosmo
MINIO_SECRET_KEY=cosmo-object-secret
MINIO_BUCKET=cosmo-documents
MINIO_SECURE=false
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
