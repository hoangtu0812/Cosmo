# PostgreSQL
POSTGRES_DB=cosmo
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgres://cosmo:change-this-database-password@db:5432/cosmo?sslmode=disable

# API and browser
APP_ADDRESS=:8080
FRONTEND_URL=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Browser-reachable backend origin used for provider-neutral MCP OAuth callbacks.
PUBLIC_API_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=24h

# Admin bootstrap. The password is hashed into PostgreSQL on API startup.
ADMIN_EMAIL=admin@cosmo.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Quản trị viên Cosmo
# Additional platform administrators, used especially with Microsoft Entra ID.
# Separate multiple addresses with commas. These accounts receive admin access
# as soon as they sign in; restart the backend after changing the value.
ADMIN_EMAILS=

# Microsoft Entra ID — register a Web application, add the redirect URI below,
# and grant delegated Microsoft Graph User.Read permission to show profile photos.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URL=http://localhost:8080/api/auth/entra/callback

# OpenAI-compatible Model Gateway, for example LiteLLM, Azure facade, vLLM or Ollama.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=company-general
LLM_REQUEST_TIMEOUT=90s

# Web search, for the built-in Web Search tool. SEARCH_URL points at the SearXNG
# instance in docker-compose: a metasearch front end that asks the public
# engines per query, so it holds no API key, bills nothing per question, and can
# therefore be called automatically under the keyless-tools rule. Leave
# SEARCH_URL empty to keep the tool installable but unable to answer.
# SEARXNG_SECRET signs that instance's own sessions; any 32+ random characters.
SEARCH_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-at-least-32-random-characters

# Knowledge Plane
RAG_SERVICE_URL=http://rag:8000
# How many documents a re-index rebuilds at once. Each one occupies the
# knowledge service and the model gateway for as long as it takes to parse and
# embed, so raise this to finish sooner and lower it to leave the gateway free.
KNOWLEDGE_REINDEX_WORKERS=4
# Record every knowledge question and what came back, in
# knowledge_retrieval_log. This is where a curated evaluation set comes from.
# It stores what people typed, so it is off until you turn it on, and the rows
# are yours to prune.
KNOWLEDGE_RETRIEVAL_LOG=false
# Per-turn retrieval limits (workers capped at 16, candidates capped at 100).
KNOWLEDGE_RETRIEVAL_WORKERS=4
KNOWLEDGE_RETRIEVAL_TIMEOUT=30s
KNOWLEDGE_RETRIEVAL_KB_TIMEOUT=10s
KNOWLEDGE_RETRIEVAL_CANDIDATES=24
# Durable chat queue: workers per process, capped at 16; whole execution deadline.
CHAT_WORKERS=2
CHAT_EXECUTION_TIMEOUT=10m
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cosmo_knowledge
# Length normalisation for lexical (BM25) scoring, counted in terms rather than
# tokens. Lower it for a corpus of short passages, raise it for long ones.
AVERAGE_PASSAGE_TERMS=400
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cosmo
MINIO_SECRET_KEY=cosmo-object-secret
MINIO_BUCKET=cosmo-documents
MINIO_SECURE=false

# Azure AI Document Intelligence, for scanned PDFs and documents whose answers
# live in tables. The prebuilt-layout model returns Markdown with the table
# structure intact; leaving the endpoint empty keeps every PDF on the local
# text-layer reader. Analysis is billed per page, so the mode decides which
# documents are worth it: auto escalates only a PDF with no usable text layer,
# always analyses every PDF, off never calls the service.
DOCUMENT_LAYOUT_ENDPOINT=
DOCUMENT_LAYOUT_KEY=
DOCUMENT_LAYOUT_MODE=auto
DOCUMENT_LAYOUT_MIN_CHARS_PER_PAGE=120
DOCUMENT_LAYOUT_API_VERSION=2024-11-30
DOCUMENT_LAYOUT_TIMEOUT=600

# Hosts a tool may reach even though they resolve to a private address, comma
# separated. Empty refuses every private address, which is what a hosted
# deployment wants; an on-premises one names its internal APIs here.
TOOL_EGRESS_ALLOWED_HOSTS=


# Default true. Only set false temporarily while backfilling legacy vectors into
# embedding profiles; ingestion always writes profiles. Enable after verifying
# every required document. See docs/ke-hoach-cai-tien-chat-agent-knowledge-base.md.
KNOWLEDGE_PROFILE_READS=true
